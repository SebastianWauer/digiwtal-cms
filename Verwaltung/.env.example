APP_ENV=production

DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# 32 zufaellige Bytes, base64-kodiert. Verschluesselt die Zugangsdaten im Vault.
# Erzeugen mit: php -r "echo base64_encode(random_bytes(32));"
VAULT_KEY_BASE64=

# Rollout ueber GitHub Actions.
# Die Verwaltung kann auf IONOS-Webspace nicht selbst uebertragen (keine
# ssh2-Erweiterung, keine Shell, FTP geschlossen). Sie startet stattdessen den
# Workflow und stellt ihm die Zugangsdaten ueber /api/ci/deploy-target bereit.
GITHUB_REPO=SebastianWauer/digiwtal-cms
# Fine-grained Token mit "Actions: Read and write" auf genau dieses Repository
GITHUB_TOKEN=
GITHUB_WORKFLOW=deploy-instanz.yml
GITHUB_BRANCH=main
