APP_ENV=production
DB_HOST=your_db_host_here
DB_PORT=3306
DB_NAME=your_db_name_here
DB_USER=your_db_user_here
DB_PASS=your_db_password_here
MIGRATION_TOKEN=your_migration_token_here
HEALTH_TOKEN=your_health_token_here
DEPLOY_TOKEN=your_deploy_token_here
SETUP_TOKEN=your_setup_token_here

# Hilfe-Funktion: Anbindung an die DIGIWTAL-Verwaltung.
# Wird beim Rollout automatisch gesetzt. Fehlen die Werte, ist die Hilfe-Seite
# sichtbar, aber das Absenden deaktiviert.
SUPPORT_URL=
SUPPORT_TOKEN=

# Pfad-Deployment (optional):
# Leer lassen, wenn das CMS auf einer eigenen Subdomain am Domain-Root liegt.
# Liegt es in einem Unterverzeichnis, hier den Pfad eintragen, z.B. /verwaltung
CMS_BASE_PATH=

# CMS_APP_ROOT wird NICHT hier gesetzt, sondern vom Webserver (SetEnv in
# public/.htaccess), weil es gebraucht wird, bevor diese Datei gelesen wird.

# Instagram-Anbindung (native Meta Graph API, kein Drittanbieter-Tool - siehe README)
# App im Meta-Entwickler-Portal anlegen: developers.facebook.com -> App -> Produkt "Instagram" hinzufuegen
# Redirect-URI dort eintragen: https://DEINE-CMS-DOMAIN/settings/instagram/callback
INSTAGRAM_APP_ID=your_instagram_app_id_here
INSTAGRAM_APP_SECRET=your_instagram_app_secret_here
# Zufaelliger 32-Byte-Schluessel, base64-kodiert, zum Verschluesseln des gespeicherten Access-Tokens.
# Erzeugen mit: php -r "echo base64_encode(random_bytes(32));"
INSTAGRAM_TOKEN_KEY_BASE64=your_base64_32byte_key_here
