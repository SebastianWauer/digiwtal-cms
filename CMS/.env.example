APP_ENV=production
DB_HOST=your_db_host_here
DB_PORT=3306
DB_NAME=your_db_name_here
DB_USER=your_db_user_here
DB_PASS=your_db_password_here
MIGRATION_TOKEN=your_migration_token_here
HEALTH_TOKEN=your_health_token_here
DEPLOY_TOKEN=your_deploy_token_here
SETUP_TOKEN=your_setup_token_here

# Pfad-Deployment (optional):
# Leer lassen, wenn das CMS auf einer eigenen Subdomain am Domain-Root liegt.
# Liegt es in einem Unterverzeichnis, hier den Pfad eintragen, z.B. /verwaltung
CMS_BASE_PATH=

# CMS_APP_ROOT wird NICHT hier gesetzt, sondern vom Webserver (SetEnv in
# public/.htaccess), weil es gebraucht wird, bevor diese Datei gelesen wird.
